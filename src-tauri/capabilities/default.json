{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities exposed to the main window: replaces the v1 allowlist.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-ask",
    "dialog:allow-open",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "**" }
      ]
    },
    "process:allow-restart",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "run-git-command", "cmd": "git", "args": true }
      ]
    },
    "updater:default"
  ]
}
