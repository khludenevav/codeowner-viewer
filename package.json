{
  "name": "codeowners-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "build-app": "tauri dev",
    "generate-routes": "tsr generate",
    "watch-routes": "tsr watch",
    "dev": "vite",
    "build": "pnpm run generate-routes && tsc -b && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview",
    "release": "tauri build",
    "release-aarch64": "CI=true tauri build --target aarch64-apple-darwin",
    "release-universal": "tauri build --target universal-apple-darwin"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tanstack/react-query": "^5.51.1",
    "@tanstack/react-router": "^1.45.0",
    "@tanstack/react-virtual": "^3.8.3",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-fs": "2.5.2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-shell": "2.3.6",
    "@tauri-apps/plugin-updater": "2.11.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "2.1.1",
    "cmdk": "^1.0.0",
    "dayjs": "1.11.10",
    "file-extension-icon-js": "^1.1.6",
    "lucide-react": "^0.408.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tanstack/router-cli": "^1.44.3",
    "@tanstack/router-devtools": "^1.45.0",
    "@tanstack/router-plugin": "^1.45.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.20.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "autoprefixer": "^10.4.19",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "oxfmt": "0.66.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2"
  }
}
