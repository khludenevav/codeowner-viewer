{
  "name": "codeowners-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build-app": "tauri dev",
    "generate-routes": "tsr generate",
    "watch-routes": "tsr watch",
    "dev": "vite",
    "build": "pnpm run generate-routes && tsc -b && vite build",
    "lint": "oxlint --report-unused-disable-directives --max-warnings 0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "preview": "vite preview",
    "release": "tauri build",
    "release-aarch64": "CI=true tauri build --target aarch64-apple-darwin",
    "release-universal": "tauri build --target universal-apple-darwin"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-virtual": "3.14.10",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-fs": "2.5.2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-shell": "2.3.6",
    "@tauri-apps/plugin-updater": "2.11.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dayjs": "1.11.23",
    "file-extension-icon-js": "1.1.6",
    "lucide-react": "1.41.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/router-cli": "1.167.33",
    "@tanstack/router-devtools": "1.167.1",
    "@tanstack/router-plugin": "1.168.35",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.5",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
